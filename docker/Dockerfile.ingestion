# Build context: project root (run with `docker build -f docker/Dockerfile.ingestion .`)
FROM python:3.13-slim AS builder

WORKDIR /app

# Install uv from official pinned image
COPY --from=ghcr.io/astral-sh/uv:0.11.3 /uv /uvx /usr/local/bin/

# Install production dependencies without dev and without optional AGPL extras
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev

# Final runtime stage
FROM python:3.13-slim

WORKDIR /app

# Create non-root user and group with explicit UID/GID 10001
RUN groupadd -g 10001 appuser && \
    useradd -r -u 10001 -g 10001 -d /app -s /sbin/nologin appuser

# Copy virtualenv from builder stage
COPY --from=builder /app/.venv /app/.venv

# Copy source code (owned by root, read-only to appuser)
COPY src/ ./src/

# Create data directory and grant appuser ownership strictly to data
RUN mkdir -p /app/data /app/data/source_docs && \
    chown -R appuser:appuser /app/data

# Activate virtual environment and configure paths
ENV PATH="/app/.venv/bin:$PATH" \
    STATE_DB_PATH="/app/data/service_ingestion_state.db" \
    SOURCE_DOCS_DIR="/app/data/source_docs"

USER appuser

EXPOSE 8002

CMD ["uvicorn", "src.ingestion.service:app", "--host", "0.0.0.0", "--port", "8002"]
