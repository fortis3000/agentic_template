# Build context: project root (run with `docker build -f docker/Dockerfile.vectordb_mcp .`)
FROM python:3.13-slim

WORKDIR /app

# Create non-root user and group for least privilege security
RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin appuser

# Install uv from the official image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Install dependencies first (cached unless pyproject.toml/uv.lock change)
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev

# Copy source code and data directory with proper ownership
COPY src/ ./src/
RUN mkdir -p /app/data && chown -R appuser:appuser /app

# Activate the virtual environment by default and configure image sandbox
ENV PATH="/app/.venv/bin:$PATH" \
    ALLOWED_IMAGE_DIR="/app/data"

USER appuser

EXPOSE 8000

CMD ["uvicorn", "src.tools.mcp.servers.vectordb:app", "--host", "0.0.0.0", "--port", "8000"]
