{
  "hooks": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "Bash|bash|run_command|execute_command",
        "hooks": [
          {
            "type": "command",
            "command": "uv run .agents/scripts/validate_tool_call.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}